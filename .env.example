# UNWIND BACKEND ENVIRONMENT CONFIGURATION

# Server & Runtime
PORT=4000
NODE_ENV=production
LOG_LEVEL=info

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/unwind?retryWrites=true&w=majority

# Firebase Admin SDK Credentials
FIREBASE_PROJECT_ID=unwind-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@unwind-app.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# AI Router Multi-Provider API Keys
OPENAI_API_KEYS=sk-proj-YourOpenAIApiKey
GEMINI_API_KEYS=AIzaSyYourGeminiApiKey
GROQ_API_KEYS=gsk_YourGroqApiKey

# Razorpay SDK Credentials (Subscriptions & Agency Invoices)
RAZORPAY_KEY_ID=rzp_live_YourRazorpayKeyId
RAZORPAY_KEY_SECRET=YourRazorpayKeySecret
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecret

# Transactional Email Credentials
RESEND_API_KEY=re_YourResendApiKey

# Amazon Web Services (S3, CloudFront, ECR)
AWS_REGION=ap-south-1
AWS_S3_BUCKET=unwind-storage-bucket
AWS_CLOUDFRONT_DOMAIN=d1111111111111.cloudfront.net
